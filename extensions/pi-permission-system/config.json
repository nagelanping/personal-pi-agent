{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/refs/heads/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": true,
  "permission": {
    "*": "allow",
    "write": "ask",
    "replace": "ask",
    "insert": "ask",
    "apply_patch": "ask",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "~/.ssh/*": "ask",
      "$HOME/.ssh/*": "ask",
      "~/.pi/agent/auth.json": "ask",
      "~/.pi/agent/models.json": "ask"
    },
    "bash": {
      "*": "ask",
      "git *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git describe*": "allow",
      "git ls-files*": "allow",
      "git ls-remote*": "allow",
      "git branch": "allow",
      "git branch --list*": "allow",
      "git tag -l*": "allow",
      "git tag --list*": "allow",
      "git stash list*": "allow",
      "git stash show*": "allow",
      "git remote -v*": "allow",
      "git remote show *": "allow",
      "git config --get*": "allow",
      "git config --list*": "allow",
      "git config -l": "allow",
      "gh *": "ask",
      "gh --version": "allow",
      "gh version": "allow",
      "gh auth status*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr status*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh search *": "allow",
      "gh repo view*": "allow",
      "gh release view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh workflow list*": "allow",
      "gh workflow view*": "allow",
      "gh config get*": "allow",
      "gh config list*": "allow",
      "gh alias list*": "allow",
      "gh gist list*": "allow",
      "gh gist view*": "allow",
      "gh label list*": "allow",
      "gh secret list*": "allow",
      "gh variable list*": "allow",
      "gh cache list*": "allow",
      "gh extension list*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "cp *": "ask",
      "mv *": "ask",
      "mkdir *": "ask",
      "sed -i*": "ask",
      "sed --in-place*": "ask",
      "perl -i*": "ask",
      "awk -i inplace*": "ask",
      "gawk -i inplace*": "ask",
      "tee *": "ask",
      "nvim *": "ask",
      "python *": "ask",
      "python3 *": "ask",
      "py *": "ask",
      "uv *": "ask"
    }
  }
}
